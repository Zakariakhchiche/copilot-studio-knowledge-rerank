# HTTP endpoint called by the Copilot Studio topic
PORT=3000
API_KEY=change-me                 # sent by the topic in the x-api-key header

# Who is asking (security trimming): "demo" trusts the x-demo-groups header (local tests only),
# "entra" validates a Microsoft Entra ID bearer token and reads its groups claim.
AUTH_MODE=demo
ENTRA_TENANT_ID=
ENTRA_AUDIENCE=                   # application ID URI of this API, e.g. api://<client-id>

# Retrieval. Without these variables the bundled fictional corpus is used (BM25, offline).
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=contracts
AZURE_SEARCH_VECTOR_FIELD=        # set to enable hybrid search (integrated vectorizer required)
AZURE_SEARCH_SEMANTIC_CONFIG=     # set to enable the built-in semantic ranker

# Reranking: none | semantic | jev
RERANK_MODE=jev
CANDIDATES=60                     # how wide to retrieve before reranking
TOP_K=15                          # Copilot Studio reads at most 15 snippets
JEV_MIN_SCORE=0.5                 # passages below this relevance probability are dropped
JEV_CONCURRENCY=16
ANONYMIZE=true                    # mask e-mails, phone numbers, IBANs and company IDs before calling Jev

# TypeSafe Jev
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=           # pin a version (e.g. jev-1.13.0) so thresholds do not drift
